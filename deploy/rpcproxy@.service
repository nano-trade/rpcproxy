# One instance per network: rpcproxy@banano reads /etc/rpcproxy/banano.json,
# rpcproxy@nano reads /etc/rpcproxy/nano.json.
[Unit]
Description=Banano/Nano RPC proxy (%i)
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/rpcproxy -config /etc/rpcproxy/%i.json
ExecStartPre=/usr/local/bin/rpcproxy -check -config /etc/rpcproxy/%i.json
Restart=always
RestartSec=2

# Runs as a throwaway unprivileged user with no write access anywhere.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target
