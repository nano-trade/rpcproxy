#!/bin/sh
# Rebuilds /etc/nginx/conf.d/cloudflare.conf from Cloudflare's published IP ranges.
#  - restores the visitor's real IP from CF-Connecting-IP (only when the peer is Cloudflare)
#  - sets $via_cloudflare = 1 for requests that came through Cloudflare (or localhost)
# Keeps the old file if the download fails or nginx rejects the new one.
set -eu
OUT=/etc/nginx/conf.d/cloudflare.conf
TMP=$(mktemp)
trap 'rm -f "$TMP" "$TMP.ranges"' EXIT

for v in 4 6; do
  curl -fsS --max-time 20 "https://www.cloudflare.com/ips-v$v"
  echo
done | grep -E '^[0-9a-f:.]+/[0-9]+$' > "$TMP.ranges"

# sanity check: Cloudflare publishes ~20 ranges
[ "$(wc -l < "$TMP.ranges")" -ge 10 ] || { echo "too few ranges, keeping old file" >&2; exit 1; }

{
  echo "# Generated by $0 on $(date -u +%F). Do not edit."
  while read -r r; do echo "set_real_ip_from $r;"; done < "$TMP.ranges"
  echo "real_ip_header CF-Connecting-IP;"
  echo
  echo 'geo $realip_remote_addr $via_cloudflare {'
  echo "    default 0;"
  echo "    127.0.0.1/32 1;"
  echo "    ::1/128 1;"
  while read -r r; do echo "    $r 1;"; done < "$TMP.ranges"
  echo "}"
} > "$TMP"

if [ -f "$OUT" ] && cmp -s "$TMP" "$OUT"; then exit 0; fi
[ -f "$OUT" ] && cp "$OUT" "$OUT.bak"
install -m 644 "$TMP" "$OUT"
if nginx -t 2>/dev/null; then
  systemctl reload nginx
else
  echo "nginx rejected new config, restoring old one" >&2
  if [ -f "$OUT.bak" ]; then mv "$OUT.bak" "$OUT"; else rm -f "$OUT"; fi
  exit 1
fi
