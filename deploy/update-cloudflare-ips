#!/bin/sh
# Generates nginx config from Cloudflare's published IP ranges.
#
#   update-cloudflare-ips            per-site mode (default)
#   update-cloudflare-ips --global   one file that applies to every site
#
# Per-site mode writes two files:
#   /etc/nginx/conf.d/rpcproxy-cloudflare-geo.conf
#       defines $via_cloudflare (1 when the request came through Cloudflare
#       or localhost). It only defines a variable, so it changes nothing by itself.
#   /etc/nginx/snippets/rpcproxy-cloudflare-realip.conf
#       restores the visitor IP from CF-Connecting-IP. Include it in the server
#       blocks that should use it:   include snippets/rpcproxy-cloudflare-realip.conf;
#
# Global mode writes /etc/nginx/conf.d/cloudflare.conf with both parts, so the
# real IP is restored for every site on the server.
#
# Safe to run from a timer: it never overwrites a file it did not generate,
# keeps the old files if the download fails, and rolls back if nginx -t fails.
set -eu

MARK="# Generated by update-cloudflare-ips"
case "${1:-}" in
  --global) GLOBAL=1 ;;
  "")       GLOBAL=0 ;;
  *) echo "usage: $0 [--global]" >&2; exit 2 ;;
esac

if [ "$GLOBAL" = 1 ]; then
  GEO_OUT=/etc/nginx/conf.d/cloudflare.conf
  REALIP_OUT=$GEO_OUT
else
  GEO_OUT=/etc/nginx/conf.d/rpcproxy-cloudflare-geo.conf
  REALIP_OUT=/etc/nginx/snippets/rpcproxy-cloudflare-realip.conf
fi

# refuse to touch files someone else wrote
for f in "$GEO_OUT" "$REALIP_OUT"; do
  if [ -e "$f" ] && ! grep -q "^$MARK" "$f"; then
    echo "$f exists and was not generated by this script; not overwriting it" >&2
    exit 1
  fi
done

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

for v in 4 6; do
  curl -fsS --max-time 20 "https://www.cloudflare.com/ips-v$v"
  echo
done | grep -E '^[0-9a-f:.]+/[0-9]+$' > "$TMP/ranges"

# sanity check: Cloudflare publishes ~20 ranges
[ "$(wc -l < "$TMP/ranges")" -ge 10 ] || { echo "too few ranges, keeping old files" >&2; exit 1; }

realip() {
  while read -r r; do echo "set_real_ip_from $r;"; done < "$TMP/ranges"
  echo "real_ip_header CF-Connecting-IP;"
}
geo() {
  echo 'geo $realip_remote_addr $via_cloudflare {'
  echo "    default 0;"
  echo "    127.0.0.1/32 1;"
  echo "    ::1/128 1;"
  while read -r r; do echo "    $r 1;"; done < "$TMP/ranges"
  echo "}"
}

if [ "$GLOBAL" = 1 ]; then
  { echo "$MARK (--global). Do not edit."; realip; echo; geo; } > "$TMP/geo"
else
  { echo "$MARK. Do not edit."; geo; } > "$TMP/geo"
  { echo "$MARK. Do not edit."; realip; } > "$TMP/realip"
fi

changed=""
install_file() { # tmpfile target
  if [ -f "$2" ] && cmp -s "$1" "$2"; then return 0; fi
  mkdir -p "$(dirname "$2")"
  rm -f "$2.bak"
  if [ -f "$2" ]; then cp "$2" "$2.bak"; fi
  install -m 644 "$1" "$2"
  changed="$changed $2"
}
install_file "$TMP/geo" "$GEO_OUT"
if [ "$GLOBAL" = 0 ]; then install_file "$TMP/realip" "$REALIP_OUT"; fi
[ -n "$changed" ] || exit 0

if nginx -t 2>/dev/null; then
  systemctl reload nginx
else
  echo "nginx rejected the new config, restoring the old one" >&2
  for f in $changed; do
    if [ -f "$f.bak" ]; then mv "$f.bak" "$f"; else rm -f "$f"; fi
  done
  exit 1
fi
